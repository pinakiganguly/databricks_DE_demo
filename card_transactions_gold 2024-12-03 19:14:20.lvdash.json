{
  "datasets": [
    {
      "name": "temp_dataset_name",
      "displayName": "card_transactions_gold",
      "queryLines": [
        "select *\r\n",
        "from\r\n",
        "  hive_metastore.demo.card_transactions_gold;"
      ]
    },
    {
      "name": "96b31cf0",
      "displayName": "Transaction_in_city_with_partic_card_num",
      "queryLines": [
        "-- Find users who have made transactions in the city starting with letter N and have a card number starting with 5 and are from the zip codes is not equal to 0\r\n",
        "select\r\n",
        "  user_id,\r\n",
        "  transaction_date\r\n",
        "from\r\n",
        "  hive_metastore.demo.card_transactions_gold\r\n",
        "where\r\n",
        "  card_number like('5%')\r\n",
        "  and zip in (\r\n",
        "    select\r\n",
        "      zip\r\n",
        "    from\r\n",
        "      hive_metastore.demo.card_transactions_gold\r\n",
        "    where\r\n",
        "      zip <> 0\r\n",
        "  )\r\n",
        "  and merchant_city in(\r\n",
        "    select\r\n",
        "      merchant_city\r\n",
        "    from\r\n",
        "      hive_metastore.demo.card_transactions_gold\r\n",
        "    where\r\n",
        "      merchant_city like('N%')\r\n",
        "  );"
      ]
    },
    {
      "name": "a7d2edd3",
      "displayName": "Maximum credit score of each users",
      "queryLines": [
        "select\n",
        "  user_id,\n",
        "  max(credit_score) as Max_credit_score\n",
        "from\n",
        "  hive_metastore.demo.card_transactions_gold\n",
        "group by\n",
        "  user_id\n",
        "order by\n",
        "  user_id;"
      ]
    },
    {
      "name": "b8ab0de3",
      "displayName": "Users from particular address whose age is 40yrs",
      "queryLines": [
        "select\n",
        "  distinct user_id,\n",
        "  card_id,\n",
        "  address,\n",
        "  credit_score,\n",
        "  current_age\n",
        "from\n",
        "  hive_metastore.demo.card_transactions_gold\n",
        "where\n",
        "  current_age = 40;"
      ]
    },
    {
      "name": "6f86625c",
      "displayName": "No of transactions done from merchants of particular city",
      "queryLines": [
        "select\n",
        "  count(transaction_id) as Number_of_transactions,\n",
        "  merchant_city\n",
        "from\n",
        "  hive_metastore.demo.card_transactions_gold\n",
        "group by\n",
        "  merchant_city\n",
        "order by\n",
        "  Number_of_transactions desc;"
      ]
    },
    {
      "name": "5454401c",
      "displayName": "No of transactions done from merchants of particular city",
      "queryLines": [
        "select\n",
        "  count(transaction_id) as Number_of_transactions,\n",
        "  merchant_city\n",
        "from\n",
        "  hive_metastore.demo.card_transactions_gold\n",
        "group by\n",
        "  merchant_city\n",
        "order by\n",
        "  Number_of_transactions desc;"
      ]
    },
    {
      "name": "48efd55e",
      "displayName": "Maximum transaction done by user  and of which card company",
      "queryLines": [
        "select\r\n",
        "  user_id,\r\n",
        "  card_brand,\r\n",
        "  max(`Amount_in_$`) as Maximum_transaction_amount\r\n",
        "from\r\n",
        "  hive_metastore.demo.card_transactions_gold\r\n",
        "group by\r\n",
        "  user_id,\r\n",
        "  card_brand\r\n",
        "order by\r\n",
        "  Maximum_transaction_amount desc;"
      ]
    }
  ],
